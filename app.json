{
  "expo": {
    "name": "Tenfold",
    "slug": "tenfold-editor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tenfold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ibrahim.tenfold",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Tenfold saves your finished videos to Photos.",
        "NSSpeechRecognitionUsageDescription": "Tenfold transcribes your videos on your iPhone to add captions and cut silences.",
        "NSCameraUsageDescription": "Tenfold uses the camera to record clips for your batches. Recordings stay on your iPhone.",
        "NSMicrophoneUsageDescription": "Tenfold records sound with your clips and your voiceovers so it can add captions, cut pauses and mix your sound. Audio stays on your iPhone.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tiktok",
          "snssdk1233",
          "instagram"
        ],
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1222",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins_400Regular.ttf",
            "./assets/fonts/Poppins_500Medium.ttf",
            "./assets/fonts/Poppins_600SemiBold.ttf",
            "./assets/fonts/Poppins_700Bold.ttf",
            "./assets/fonts/Inter_900Black.ttf",
            "./assets/fonts/BebasNeue_400Regular.ttf",
            "./assets/fonts/Montserrat_800ExtraBold.ttf",
            "./assets/fonts/TikTokSans_800ExtraBold.ttf",
            "./assets/fonts/TikTokSans_600SemiBold.ttf",
            "./assets/fonts/ComicNeue_700Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Tenfold uses the camera to record clips for your batches. Recordings stay on your iPhone.",
          "microphonePermission": "Tenfold records sound with your clips and your voiceovers so it can add captions, cut pauses and mix your sound. Audio stays on your iPhone.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/withQuotedBundleScript.js",
      "./plugins/withStoreKitConfig.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6f7be037-75f7-4a9b-9d47-a7f4f5773004"
      }
    },
    "owner": "ibrahim1774"
  }
}
